{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nthanda pilot lesson manifest 2.0",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "lesson_version",
    "language",
    "source",
    "syllabus",
    "tracking",
    "sections",
    "alternative_explanations",
    "assessments",
    "teaching_links",
    "assessment_links",
    "media",
    "review",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "nthanda-pilot-2.0"
    },
    "lesson_id": {
      "type": "string"
    },
    "lesson_version": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "version",
        "sha256"
      ]
    },
    "syllabus": {
      "type": "object",
      "required": [
        "curriculum_id",
        "edition",
        "subject",
        "form",
        "printed_pages"
      ]
    },
    "tracking": {
      "type": "object",
      "required": [
        "learner_timer_visible",
        "sections",
        "lesson_total",
        "storage",
        "idle_pause_seconds"
      ],
      "properties": {
        "learner_timer_visible": {
          "const": false
        },
        "idle_pause_seconds": {
          "type": "integer"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "title",
          "content_path",
          "criterion_ids",
          "block_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "content_path": {
            "type": "string"
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "block_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "audience",
          "source_block_ids",
          "parent_section_ids",
          "criterion_ids",
          "text"
        ]
      }
    },
    "assessments": {
      "type": "object",
      "required": [
        "learner_written_path",
        "protected_marking_reference",
        "protected_source_rubric_reference",
        "automatic_policy",
        "original_written_policy"
      ]
    },
    "teaching_links": {
      "type": "array"
    },
    "assessment_links": {
      "type": "array"
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "path",
          "required",
          "production_status",
          "review_status",
          "reviewer",
          "approved_source_version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "video",
              "audio",
              "image",
              "animation",
              "pronunciation"
            ]
          },
          "path": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "production_status": {
            "enum": [
              "planned",
              "produced"
            ]
          },
          "review_status": {
            "enum": [
              "pending",
              "approved",
              "requires-changes"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "reviewer",
        "approved_source_version"
      ]
    },
    "publication": {
      "type": "object",
      "required": [
        "status",
        "blockers"
      ]
    }
  }
}